{
  "manifest_version": 3,
  "name": "Web & PDF Highlighter",
  "version": "0.1.0",
  "key": "",
  "description": "Highlight text on webpages and PDFs. Local-first, with optional Google Drive sync.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Web & PDF Highlighter"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity",
    "alarms",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "oauth2": {
    "client_id": "822884010982-dup47e3d468lidr9j2mg2f8gcb4c8rtp.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "commands": {
    "highlight-selection": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Highlight the selected text"
    }
  },
  "web_accessible_resources": [
    { "resources": ["pdf/index.html"], "matches": ["<all_urls>"] }
  ]
}
